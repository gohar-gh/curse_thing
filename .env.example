# Postgres connection string (Neon or Supabase)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob storage (for cached certificate PNG/PDF)
BLOB_READ_WRITE_TOKEN=

# --- Armenian V-POS (Ameriabank vPOS 3.1) ---
# TODO(vpos-credentials): these are placeholders. Real ClientID/Username/
# Password must come from Ameriabank before going live, and the production
# base URL (the doc only documents the test host below) must be confirmed
# with the bank. See providers/vpos.ts for where these are used.
VPOS_CLIENT_ID=
VPOS_USERNAME=
VPOS_PASSWORD=
VPOS_BASE_URL=https://servicestest.ameriabank.am/VPOS

# Base URL of this deployment, used to build absolute callback/redirect URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Dev-only override for the app's country/pricing detection (?cc=AM is also
# supported directly on requests). Never read in production.
NEXT_PUBLIC_ENABLE_CC_OVERRIDE=true

# Moderation/takedown contact used on the "report this certificate" link
# (spec §13) — swap for the operator's real inbox before launch.
MODERATION_EMAIL=registrar@example.com

# Shared-secret token gating /admin/unpublish (spec §13's admin unpublish
# route). There is no accounts system for this product, so this is the one
# access control for that specific moderation action. Set a long random
# value in production.
ADMIN_SECRET=

# Local-dev-only: @sparticuz/chromium's bundled binary is Linux-only (built
# for Vercel's serverless runtime), so PDF rendering can't launch it on a
# macOS/Windows dev machine. Point this at a locally installed Chrome/
# Chromium to test PDF generation locally; leave unset in production so the
# Vercel-compatible binary is used.
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
